# Переменные окружения для DeluxeBotNavigator
# Скопируйте этот файл в .env и заполните своими данными

# Токен бота Telegram (получите у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администратора (ваш Telegram ID)
ADMIN_ID=your_telegram_id_here

# Настройки email для отзывов (опционально)
# Email для получения отзывов
REVIEW_EMAIL=your_email@example.com

# Настройки SMTP сервера
SMTP_SERVER=smtp.gmail.com #smtp.yandex.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com #IDELUXEBOT@yandex.com
SMTP_PASSWORD=your_app_password #xesdhzvpfzpsdqfg
